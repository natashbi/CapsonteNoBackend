# =============================================================================
# WeCare Backend — Environment Configuration
# Copy this file to `.env` and fill in your values.
# =============================================================================

# --- Database Configuration ---
# Choose ONE setup:
#
# (A) LOCAL POSTGRES — install PostgreSQL on your machine
#   DB_HOST=localhost
#   DB_PORT=5432
#   DB_NAME=wecare_db
#   DB_USER=postgres
#   DB_PASSWORD=your_local_postgres_password
#
# (B) SUPABASE (shared cloud DB — recommended for team projects)
#   Get the connection string from: Project Settings → Database → Connection parameters
#   The DB_HOST will look like: db.xxxxxxxxxxx.supabase.co
#   SSL is auto-enabled when DB_HOST contains 'supabase'.
#
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wecare_db
DB_USER=postgres
DB_PASSWORD=changeme

# --- Server Configuration ---
PORT=3001
NODE_ENV=development

# --- JWT Configuration ---
# IMPORTANT: change this to a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRE=7d

# --- CORS — must match the frontend URL (Vite default is 5173) ---
CORS_ORIGIN=http://localhost:5173
